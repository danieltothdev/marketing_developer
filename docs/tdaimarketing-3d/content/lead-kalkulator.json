 "extraJs": "<script>\n(function(){var el=function(i){return document.getElementById(i)};\nvar f=function(n){return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g,'\\u00a0')};\nvar ids=['k1','k2','k3','k4'];\nfunction fill(x){x.style.setProperty('--fill',((x.value-x.min)/(x.max-x.min)*100)+'%')}\nfunction upd(){\n  var K=+el('k1').value,L=+el('k2').value,R=+el('k3').value,V=+el('k4').value;\n  ids.forEach(function(i){fill(el(i))});\n  el('v1').textContent=f(K)+' Ft';el('v2').textContent=L+' db';el('v3').textContent=R+'%';el('v4').textContent=f(V)+' Ft';\n  var cpl=L>0?K/L:0, ugyfel=L*R/100, cac=ugyfel>0?K/ugyfel:0, bev=ugyfel*V, ered=bev-K;\n  el('cpl').textContent=L>0&&K>0?f(cpl)+' Ft':'nem mérhető';\n  el('cac').innerHTML=ugyfel>0?'Egy ügyfél megszerzése: <b>'+f(cac)+' Ft</b>':'Mért megkeresés nélkül ez nem számolható.';\n  el('roi').textContent=(ered>=0?'+ ':'− ')+f(Math.abs(ered))+' Ft';\n  el('roiSub').innerHTML=ugyfel.toFixed(1).replace('.0','')+' ügyfél × '+f(V)+' Ft − '+f(K)+' Ft keret';\n}\nids.forEach(function(i){el(i).addEventListener('input',upd)});upd();\n})();</script>"
