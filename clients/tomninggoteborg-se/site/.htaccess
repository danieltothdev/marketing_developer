# Csupasz /tjanster és régi /omraden/goteborg -> értelmes cél (különben 404 lenne)
RedirectMatch 301 ^/tjanster/?$ /tjanster/tomning-i-goteborg
RedirectMatch 301 ^/omraden/goteborg/?$ /omraden

# Hibás, SZÓ SZERINTI placeholder URL-ek (a régi AI feloldatlanul tette ki őket) -> 410 Gone.
# FONTOS: csak a literál ":slug"/"{dynamic}" stringre illeszkedik, a valós oldalakra NEM.
RedirectMatch 410 ^/foretagsflytt-:slug/?$
RedirectMatch 410 ^/foretagsflytt-\{dynamic\}/?$
RedirectMatch 410 ^/kontorsflytt-:slug/?$
RedirectMatch 410 ^/kundfall/:slug/?$
RedirectMatch 410 ^/omraden/:slug/?$

DirectoryIndex index.html
